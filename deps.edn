{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj).
 ;;
 ;; Like the fuel-wholesale (`cloud-itonami-isic-4671`), general-trading
 ;; (`cloud-itonami-isic-4690`), commission-brokerage
 ;; (`cloud-itonami-isic-4610`), agri-wholesale (`cloud-itonami-isic-4620`),
 ;; provision-trading (`cloud-itonami-isic-4630`), metal-wholesale
 ;; (`cloud-itonami-isic-4662`) and textile-wholesale
 ;; (`cloud-itonami-isic-4641`) siblings, this waste/scrap-wholesale
 ;; vertical is SELF-CONTAINED: there is no `kotoba-lang/wastetrade` to
 ;; delegate waste-trading / transboundary-consent validation to, so the
 ;; credit-clearance / contract-on-file / prior-informed-consent /
 ;; sanctions-screening checks live as direct entity boolean reads in
 ;; `wastetrade.governor` rather than wrapping an external lib. This repo
 ;; is standalone (forkable outside the workspace); the :local/root paths
 ;; only resolve inside the monorepo checkout -- a standalone fork should
 ;; override them with git coordinates.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        ;; shared langchain.db store seam (EDN-blob codec + identity
        ;; schema + field-spec entity helpers) -- ADR-2607141600.
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "wastetrade.sim"]}
  ;; clojure -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by driving the REAL actor stack
  ;; (operation -> governor -> store) and rendering what it produced.
  ;; No jp-go-dds git dep on purpose: the DADS primitives the console
  ;; references are inlined from this repo's own vendored docs/index.html
  ;; token block, so the build stays offline.
  :render-html {:main-opts ["-m" "wastetrade.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
